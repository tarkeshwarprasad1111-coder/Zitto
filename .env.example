# Database
DATABASE_URL=postgresql://zitto:zitto_dev@localhost:5432/zitto?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Auth
JWT_ACCESS_SECRET=change-me-in-production-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret-min-32-chars
JWT_ACCESS_TTL=300
JWT_REFRESH_TTL=2592000
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# OTP
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4001

# Admin
ADMIN_PORT=3001

# Realtime
REALTIME_PORT=4001

# Game Engine
GAME_ENGINE_PORT=4002
GAME_ROUND_BETTING_MS=20000
GAME_ROUND_DRAWING_MS=6000
GAME_ROUND_RESULT_MS=4000

# Wallet
SIGNUP_BONUS_COINS=500
DAILY_REWARD_COINS=100
MIN_BET=10
MAX_BET=10000

# Feature flags
FEATURE_REAL_MONEY=false
FEATURE_LIVE_DEALER=false
FEATURE_SPIN_WHEEL=false

# Monitoring (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
